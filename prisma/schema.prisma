generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum ProfileVisibility {
  public
  private
}

enum PetEnergyLevel {
  low
  moderate
  high
}

enum PetSpecies {
  dog
  cat
  bird
  other
}

enum PetSize {
  small
  medium
  large
}

enum PetGender {
  male
  female
}

enum PetMediaType {
  image
  video
}

enum ReactionType {
  heart //'❤️'
  laugh //'😂'
  wow //'😮'
  sad //'😢'
  angry //'😠'
  fire //'🔥'
  clap //'👏'
  celebrate //'🎉'
}

enum AuthProvider {
  google
  apple
}

enum ActionTakenBy {
  user
  system
  admin
}

model File {
  id        String  @id @default(cuid())
  key       String
  userId    String?
  extension String?
  url       String?
  type      String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("files")
}

model PetProfile {
  id    String @id @default(cuid())
  name  String
  breed String
  age   Int
  bio   String
  media Json[]

  visibility ProfileVisibility @default(public)

  // Optional fields
  media_type             PetMediaType?
  species                PetSpecies?
  gender                 PetGender?
  size                   PetSize?
  energy_level           PetEnergyLevel?
  vaccination_status     String?
  neutered_status        String?
  display_picture        String?
  temperament_tags       String[]
  available_for_adoption Boolean         @default(false)
  owner_account_deleted  Boolean         @default(false)

  // Relationship 1:1
  owner_id String @unique
  owner    Owner  @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  posts          Post[]         @relation("AuthorPosts")
  comments       Comment[]
  commentReplies CommentReply[]
  reactions      Reaction[]
  likedPosts     LikedPost[]    @relation("LikedBy")

  @@map("pet_profiles")
}

model Owner {
  id             String  @id @default(cuid())
  email          String  @unique
  email_verified Boolean @default(false)
  deactivated    Boolean @default(false)
  deleted        Boolean @default(false)

  auth_provider  AuthProvider   @default(google)
  deleted_by     ActionTakenBy?
  deactivated_by ActionTakenBy?

  looking_for                String[]
  preferred_meetup_locations String[]
  visibility                 ProfileVisibility @default(private)
  travel_radius              Int?
  longitude                  Float?
  latitude                   Float?
  city                       String?
  state                      String?
  zip_code                   String?
  country                    String?
  bio                        String?
  display_name               String?
  display_picture            String?

  // Relationship
  petProfile PetProfile?

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deleted_at     DateTime?
  deactivated_at DateTime?

  @@map("owners")
}

model Post {
  id String @id @default(cuid())

  content String
  media   Json[]

  author_id String
  author    PetProfile @relation("AuthorPosts", fields: [author_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  likeCount Int @default(0)
  viewCount Int @default(0)

  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  comments   Comment[]
  reactions  Reaction[]
  likedPosts LikedPost[]

  @@index([author_id])
  @@index([author_id, createdAt])
  @@map("posts")
}

model LikedPost {
  id String @id @default(cuid())

  liked_by_id String
  liked_by    PetProfile @relation("LikedBy", fields: [liked_by_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  post_id          String?
  comment_id       String?
  comment_reply_id String?

  post         Post?         @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  comment      Comment?      @relation(fields: [comment_id], references: [id], onDelete: Cascade)
  commentReply CommentReply? @relation(fields: [comment_reply_id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([liked_by_id, post_id])
  @@unique([liked_by_id, comment_id])
  @@unique([liked_by_id, comment_reply_id])
  @@map("liked_posts")
}

model Comment {
  id String @id @default(cuid())

  post_id String
  post    Post   @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  author_id String
  author    PetProfile @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  likeCount Int @default(0)

  content        String
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  commentReplies CommentReply[]
  reactions      Reaction[]
  likedPosts     LikedPost[]

  @@index([author_id])
  @@index([post_id])
  @@index([post_id, createdAt])
  @@index([author_id, createdAt])
  @@map("comments")
}

model CommentReply {
  id String @id @default(cuid())

  comment_id String
  comment    Comment @relation(fields: [comment_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  author_id String
  author    PetProfile @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  likeCount Int @default(0)

  content    String
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  reactions  Reaction[]
  likedPosts LikedPost[]

  @@index([author_id, comment_id])
  @@index([comment_id, createdAt])
  @@map("comment_replies")
}

model Reaction {
  id   String       @id @default(cuid())
  type ReactionType

  post_id          String?
  comment_id       String?
  comment_reply_id String?

  author_id String
  author    PetProfile @relation(fields: [author_id], references: [id], onDelete: Cascade)

  post         Post?         @relation(fields: [post_id], references: [id], onDelete: Cascade)
  comment      Comment?      @relation(fields: [comment_id], references: [id], onDelete: Cascade)
  commentReply CommentReply? @relation(fields: [comment_reply_id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([author_id, post_id, type])
  @@unique([author_id, comment_id, type])
  @@unique([author_id, comment_reply_id, type])
  @@index([post_id, type])
  @@map("reactions")
}
