generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum ProfileVisibility {
  public
  private
}

enum PetEnergyLevel {
  low
  moderate
  high
}

enum PetSpecies {
  dog
  cat
  bird
  other
}

enum PetSize {
  small
  medium
  large
}

enum PetGender {
  male
  female
}

enum PetMediaType {
  image
  video
}

enum ReactionType {
  heart //'❤️'
  laugh //'😂'
  wow //'😮'
  sad //'😢'
  angry //'😠'
  fire //'🔥'
  clap //'👏'
  celebrate //'🎉'
}

enum AuthProvider {
  google
  apple
}

enum ActionTakenBy {
  user
  system
  admin
}

enum ConnectionRequestStatus {
  pending
  accepted
  rejected
}

enum FriendRequestStatus {
  pending
  accepted
  rejected
}

enum VoteValue {
  up
  down
}

enum ParticipantStatus {
  requested
  accepted
  rejected
}

enum ConversationType {
  direct
  group
}

model File {
  id        String  @id @default(cuid())
  key       String
  userId    String?
  extension String?
  url       String?
  type      String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("files")
}

model PetProfile {
  id    String @id @default(cuid())
  name  String
  breed String
  age   Int
  bio   String
  media Json[]

  visibility ProfileVisibility @default(public)

  // Optional fields
  media_type             PetMediaType?
  species                PetSpecies?
  gender                 PetGender?
  size                   PetSize?
  energy_level           PetEnergyLevel?
  vaccination_status     String?
  neutered_status        String?
  display_picture        String?
  temperament_tags       String[]
  available_for_adoption Boolean         @default(false)
  owner_account_deleted  Boolean         @default(false)

  // Relationship 1:1
  owner_id String @unique
  owner    Owner  @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  created_at                   DateTime            @default(now())
  updated_at                   DateTime            @updatedAt
  posts                        Post[]              @relation("AuthorPosts")
  comments                     Comment[]
  comment_replies              CommentReply[]
  reactions                    Reaction[]
  liked_posts                  LikedPost[]         @relation("LikedBy")
  sent_connection_requests     ConnectionRequest[] @relation("ConnectionRequestSender")
  received_connection_requests ConnectionRequest[] @relation("ConnectionRequestReceiver")
  connections_as_pet           Connection[]        @relation("ConnectionPet")
  connections_as_connected_pet Connection[]        @relation("ConnectedPet")

  @@map("pet_profiles")
}

model Owner {
  id             String  @id @default(cuid())
  email          String  @unique
  email_verified Boolean @default(false)
  deactivated    Boolean @default(false)
  deleted        Boolean @default(false)

  auth_provider  AuthProvider   @default(google)
  deleted_by     ActionTakenBy?
  deactivated_by ActionTakenBy?

  looking_for                String[]
  preferred_meetup_locations String[]
  visibility                 ProfileVisibility @default(private)
  travel_radius              Int?
  longitude                  Float?
  latitude                   Float?
  city                       String?
  location                   String?
  state                      String?
  zip_code                   String?
  country                    String?
  bio                        String?
  display_name               String?
  display_picture            String?

  // Relationship
  pet_profile PetProfile?

  created_at                DateTime                  @default(now())
  updated_at                DateTime                  @updatedAt
  deleted_at                DateTime?
  deactivated_at            DateTime?
  community_posts           CommunityPost[]
  community_comments        CommunityComment[]
  friends                   Friend[]                  @relation("FriendOwner")
  friends_as_friend         Friend[]                  @relation("FriendOfOwner")
  sent_friend_requests      FriendRequest[]           @relation("FriendRequestSender")
  received_friend_requests  FriendRequest[]           @relation("FriendRequestReceiver")
  community_post_votes      CommunityPostVote[]
  conversation_participants ConversationParticipant[]
  messages                  Message[]
  message_receipts          MessageReceipt[]

  @@map("owners")
}

model Post {
  id String @id @default(cuid())

  content String
  media   Json[]

  author_id String
  author    PetProfile @relation("AuthorPosts", fields: [author_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  like_count Int @default(0)
  view_count Int @default(0)

  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt
  comments    Comment[]
  reactions   Reaction[]
  liked_posts LikedPost[]

  @@index([author_id])
  @@index([author_id, created_at])
  @@map("posts")
}

model LikedPost {
  id String @id @default(cuid())

  liked_by_id String
  liked_by    PetProfile @relation("LikedBy", fields: [liked_by_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  post_id          String?
  comment_id       String?
  comment_reply_id String?

  post          Post?         @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  comment       Comment?      @relation(fields: [comment_id], references: [id], onDelete: Cascade)
  comment_reply CommentReply? @relation(fields: [comment_reply_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([liked_by_id, post_id])
  @@unique([liked_by_id, comment_id])
  @@unique([liked_by_id, comment_reply_id])
  @@map("liked_posts")
}

model Comment {
  id String @id @default(cuid())

  post_id String
  post    Post   @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  author_id String
  author    PetProfile @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  like_count Int @default(0)

  content         String
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt
  comment_replies CommentReply[]
  reactions       Reaction[]
  liked_posts     LikedPost[]

  @@index([author_id])
  @@index([post_id])
  @@index([post_id, created_at])
  @@index([author_id, created_at])
  @@map("comments")
}

model CommentReply {
  id String @id @default(cuid())

  comment_id String
  comment    Comment @relation(fields: [comment_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  author_id String
  author    PetProfile @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  like_count Int @default(0)

  content     String
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt
  reactions   Reaction[]
  liked_posts LikedPost[]

  @@index([author_id, comment_id])
  @@index([comment_id, created_at])
  @@map("comment_replies")
}

model Reaction {
  id   String       @id @default(cuid())
  type ReactionType

  post_id          String?
  comment_id       String?
  comment_reply_id String?

  author_id String
  author    PetProfile @relation(fields: [author_id], references: [id], onDelete: Cascade)

  post          Post?         @relation(fields: [post_id], references: [id], onDelete: Cascade)
  comment       Comment?      @relation(fields: [comment_id], references: [id], onDelete: Cascade)
  comment_reply CommentReply? @relation(fields: [comment_reply_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())

  @@unique([author_id, post_id, type])
  @@unique([author_id, comment_id, type])
  @@unique([author_id, comment_reply_id, type])
  @@index([post_id, type])
  @@map("reactions")
}

model Connection {
  id String @id @default(cuid())

  pet_id           String
  connected_pet_id String

  pet           PetProfile @relation("ConnectionPet", fields: [pet_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  connected_pet PetProfile @relation("ConnectedPet", fields: [connected_pet_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([pet_id, connected_pet_id])
  @@map("connections")
}

model ConnectionRequest {
  id String @id @default(cuid())

  sender_pet_id   String
  receiver_pet_id String
  status          ConnectionRequestStatus @default(pending)

  sender   PetProfile @relation("ConnectionRequestSender", fields: [sender_pet_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  receiver PetProfile @relation("ConnectionRequestReceiver", fields: [receiver_pet_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([sender_pet_id, receiver_pet_id])
  @@map("connection_requests")
}

model Friend {
  id String @id @default(cuid())

  owner_id        String
  friend_owner_id String

  owner        Owner @relation("FriendOwner", fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  friend_owner Owner @relation("FriendOfOwner", fields: [friend_owner_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([owner_id, friend_owner_id])
  @@map("friends")
}

model FriendRequest {
  id String @id @default(cuid())

  sender_owner_id   String
  receiver_owner_id String
  status            FriendRequestStatus @default(pending)

  sender   Owner @relation("FriendRequestSender", fields: [sender_owner_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  receiver Owner @relation("FriendRequestReceiver", fields: [receiver_owner_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([sender_owner_id, receiver_owner_id])
  @@map("friend_requests")
}

model CommunityPost {
  id      String @id @default(cuid())
  title   String
  content String

  author_id String
  author    Owner  @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // optional
  media Json[]
  tags  String[]

  upvotes   Int @default(0)
  downvotes Int @default(0)
  score     Int @default(0)

  // I have small notes for myself on score calc
  // score = new_state - old_state
  // states: none = 0, up = +1, down = -1

  created_at           DateTime            @default(now())
  updated_at           DateTime            @updatedAt
  community_comments   CommunityComment[]
  community_post_votes CommunityPostVote[]

  @@index([author_id])
  @@index([author_id, created_at])
  @@index([score, created_at])
  @@index([created_at])
  @@index([tags], type: Gin)
  @@map("community_posts")
}

model CommunityPostVote {
  id String @id @default(cuid())

  post_id   String
  author_id String
  value     VoteValue

  author Owner         @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  post   CommunityPost @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([post_id, author_id])
  @@index([post_id])
  @@map("community_post_votes")
}

model CommunityComment {
  id      String @id @default(cuid())
  content String

  author_id String
  post_id   String

  author Owner         @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  post   CommunityPost @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([author_id])
  @@index([post_id])
  @@index([post_id, created_at])
  @@index([author_id, created_at])
  @@map("community_comments")
}

// Conversations
model Conversation {
  id String @id @default(cuid())

  participants ConversationParticipant[]
  messages     Message[]

  type        ConversationType @default(direct)
  pairing_key String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([type, pairing_key])
  @@index([created_at])
  @@map("conversations")
}

model ConversationParticipant {
  id String @id @default(cuid())

  conversation_id String
  owner_id        String

  status ParticipantStatus @default(requested)

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  owner        Owner        @relation(fields: [owner_id], references: [id], onDelete: Cascade)

  last_read_message_id String?
  last_read_message    Message? @relation(fields: [last_read_message_id], references: [id], onDelete: Cascade)

  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  joined_at    DateTime?
  last_read_at DateTime?

  @@unique([conversation_id, owner_id])
  @@index([conversation_id, owner_id])
  @@map("conversation_participants")
}

model Message {
  id      String @id @default(cuid())
  content String

  conversation_id String
  sender_id       String

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender       Owner        @relation(fields: [sender_id], references: [id], onDelete: Cascade)

  created_at                DateTime                  @default(now())
  updated_at                DateTime                  @updatedAt
  message_receipts          MessageReceipt[]
  conversation_participants ConversationParticipant[]

  @@map("messages")
}

model MessageReceipt {
  id String @id @default(cuid())

  message_id String
  owner_id   String

  delivered_at DateTime?
  read_at      DateTime?

  message Message @relation(fields: [message_id], references: [id], onDelete: Cascade)
  owner   Owner   @relation(fields: [owner_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([message_id, owner_id])
  @@index([message_id, owner_id])
  @@map("message_receipts")
}
